<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.apartmentsystem.mapper.RepairMapper">
    <insert id="insertRepair">
        INSERT INTO repairs (house_id, description, status, created_at, updated_at)
        VALUES (#{house_id}, #{description}, #{status}, NOW(), NOW())
    </insert>
    <update id="updateRepairStatusById">
        UPDATE repairs
        SET status = #{status}, updated_at = #{updated_at}
        WHERE id = #{id}
    </update>
    <select id="selectRepairByHouseId" resultType="com.apartmentsystem.entity.Repair">
        SELECT * FROM repairs
        WHERE house_id = #{house_id}
    </select>
    <select id="getAllRepairs" resultType="com.apartmentsystem.entity.Repair">
        SELECT * FROM repairs
    </select>
</mapper>