<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.apartmentsystem.mapper.FeeMapper">
    <insert id="insertFee" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO fee (fee_number, house_number, type, amount, due_date, paid, created_at, updated_at) VALUES
        (#{fee_number}, #{house_number}, #{type}, #{amount}, DATE_ADD(NOW(), INTERVAL 30 MINUTE), false, NOW(), NOW())
    </insert>
    <update id="updateFeePaidById">
        UPDATE fee SET paid = true, updated_at = NOW() WHERE id = #{id}
    </update>
    <select id="getFeeById" resultType="com.apartmentsystem.entity.Fee">
        SELECT * FROM fee WHERE id = #{id}
    </select>
    <select id="getFeeByHouseNumber" resultType="com.apartmentsystem.entity.Fee">
        SELECT * FROM fee WHERE house_number = #{house_number}
    </select>
    <select id="getFeeByStatus" resultType="com.apartmentsystem.entity.Fee">
        SELECT * FROM fee WHERE paid = #{status}
    </select>
    <select id="getFeeByFeeNumber" resultType="com.apartmentsystem.entity.Fee">
        SELECT * FROM fee WHERE fee_number = #{fee_number}
    </select>
</mapper>